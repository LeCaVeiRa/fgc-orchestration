# Copie para .env (não versionado) e preencha. Gere valores fortes, ex.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# O docker-compose falha na subida se alguma variável obrigatória estiver vazia.

# Chave HS256 compartilhada por Users (emissor), Catalog, Kong e Lambda HistoryApi. Mínimo 32 caracteres.
JWT_KEY=

# Usuário "fgc" do Postgres (databases fgc_users e fgc_catalog).
POSTGRES_PASSWORD=

# Credenciais do RabbitMQ (broker e as 3 APIs).
RABBITMQ_USER=fgc
RABBITMQ_PASSWORD=

# Login do Grafana (http://127.0.0.1:3000).
GRAFANA_ADMIN_USER=fgc-admin
GRAFANA_ADMIN_PASSWORD=

# Opcional: URL do HttpApi da Lambda de notificações (output HistoryApiUrl). Vazia = /notifications desligada no Kong.
NOTIFICATIONS_HISTORY_URL=
